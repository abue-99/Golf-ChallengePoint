golf-challengepoint.com, www.golf-challengepoint.com {

        encode gzip

        # All API traffic goes through the Next.js BFF routes under /api/*.
        # They convert the httpOnly "token" cookie into a bearer Authorization
        # header and call the NestJS backend internally (API_URL).
        # The NestJS backend itself is intentionally NOT exposed publicly.
        handle /api/* {
                reverse_proxy web:3000
        }

        # Web: all other requests go to the Next.js frontend
        handle {
                reverse_proxy web:3000
        }
}
