golf-challengepoint.com, www.golf-challengepoint.com {

        encode gzip

        # Auth routes: handled by Next.js, which proxies to the NestJS backend
        # internally and sets the session cookie.
        handle /api/auth/* {
                reverse_proxy web:3000
        }

        # Auth-sensitive routes must pass through the Next.js proxy so the
        # httpOnly "token" cookie can be converted into a bearer Authorization header.
        handle /api/users* {
                reverse_proxy web:3000
        }

        handle /api/clubs* {
                reverse_proxy web:3000
        }

        handle /api/teams* {
                reverse_proxy web:3000
        }

        handle /api/players* {
                reverse_proxy web:3000
        }

        handle /api/lessons* {
                reverse_proxy web:3000
        }

        handle /api/development-plans* {
                reverse_proxy web:3000
        }

        handle /api/calendar* {
                reverse_proxy web:3000
        }

        handle /api/journeys* {
                reverse_proxy web:3000
        }

        handle /api/assignments* {
                reverse_proxy web:3000
        }

        handle /api/coach/players* {
                reverse_proxy web:3000
        }

        handle /api/coach/teams* {
                reverse_proxy web:3000
        }

        handle /api/coach/journeys* {
                reverse_proxy web:3000
        }

        # Coach home (roster, feedback inbox, private notes).
        handle /api/coach/roster* {
                reverse_proxy web:3000
        }

        # Remaining API routes go directly to the NestJS backend.
        handle /api/* {
                uri strip_prefix /api
                reverse_proxy api:4000
        }

        # Web: all other requests go to the Next.js frontend
        handle {
                reverse_proxy web:3000
        }
}
