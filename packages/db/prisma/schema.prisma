// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  COACH
  ADMIN
  SYSADMIN
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum OwnerType {
  PLAYER
  TEAM
}

enum LessonFocusArea {
  SETUP
  PUTTING
  SHORT_GAME
  LONG_GAME
  TACTICAL
  FITNESS
  MENTAL
}

enum LessonStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum LessonVisibility {
  PUBLIC
  PRIVATE
  /// Coaches who share a club with the author.
  CLUB
}

enum LessonPriority {
  LOW
  MEDIUM
  HIGH
}

enum CalendarTaskStatus {
  PLANNED
  COMPLETED
}

enum AvailabilityBlockType {
  SCHOOL
  WORK
  HOLIDAY
  TRAVEL
  CUSTOM
}

enum TournamentPriority {
  PRIORITY_1
  PRIORITY_2
  PRIORITY_3
}

enum DevelopmentMilestoneStatus {
  PLANNED
  COMPLETED
}

enum GoalAchieved {
  YES
  PARTIALLY
  NO
}

enum AssignmentStatus {
  NEW
  OPEN
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum AssignmentTargetType {
  PLAYER
  TEAM
  GROUP
}

enum AssignmentSourceType {
  PLAYER
  TEAM
  GROUP
}

enum JourneyDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum JourneyVisibility {
  PUBLIC
  PRIVATE
  /// Coaches who share a club with the author.
  CLUB
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  profileImage String?
  name         String?
  gender       String?
  phoneNumber  String?
  timezone     String?
  country      String?
  /// Training load per week (minutes) the coaches aim to stay below; null = default.
  weeklyLoadLimit Int?
  /// Player's weekly goal in practice days (1–7); null = default (3).
  weeklyGoalDays  Int?
  /// Coach home: activity feed entries up to this time count as seen.
  feedSeenAt      DateTime?
  /// Push notification settings per kind, e.g. {"messages": false}.
  notificationPrefs Json?
  role         Role      @default(PLAYER)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  playerProfile    PlayerProfile?
  coachPlayerLinks CoachPlayerLink[] @relation("CoachToPlayer")
  playerCoachLinks CoachPlayerLink[] @relation("PlayerToCoach")
  userClubs        UserClub[]
  coachTeams       Team[]            @relation("CoachTeams")
  teamMemberships  TeamMember[]
  practiceSlots    PracticeSlot[]    @relation("PlayerSlots")
  coachTasks       CalendarTask[]    @relation("CoachTasks")
  coachLessons         TrainingLesson[]        @relation("CoachLessons")
  playerLessons        TrainingLesson[]        @relation("PlayerLessons")
  coachDevelopmentPlans PlayerDevelopmentPlan[] @relation("CoachPlans")
  playerDevelopmentPlans PlayerDevelopmentPlan[] @relation("PlayerPlans")
  coachTrainingBlocks  TrainingBlock[]         @relation("CoachBlocks")
  lessonAssignments    LessonAssignment[]      @relation("PlayerAssignments")
  journeyTemplates     JourneyTemplate[]       @relation("CoachJourneyTemplates")
  journeyTemplatePlayerAssignments JourneyTemplateAssignment[] @relation("JourneyTemplatePlayerAssignments")
  journeyTemplateCoachAssignments JourneyTemplateAssignment[] @relation("JourneyTemplateCoachAssignments")
  availabilityBlocks   AvailabilityBlock[]
  tournaments          Tournament[]
  teamEvents           TeamEvent[]             @relation("CoachTeamEvents")
  coachPlayerNotes     CoachPlayerNote[]       @relation("CoachNotes")
  notesAboutPlayer     CoachPlayerNote[]       @relation("NotesAboutPlayer")
  calendarFeedToken    CalendarFeedToken?
  attendances          Attendance[]            @relation("PlayerAttendances")
  attendanceReminders  AttendanceReminder[]    @relation("ReminderSender")
  teamStaff            TeamCoach[]             @relation("TeamStaff")
  createdSlots         PracticeSlot[]          @relation("SlotCreator")
  slotExceptions       PracticeSlotException[] @relation("SlotExceptionChanger")
  coachConversations   Conversation[]          @relation("ConversationCoach")
  playerConversations  Conversation[]          @relation("ConversationPlayer")
  sentMessages         Message[]               @relation("MessageSender")
  activityEvents       ActivityEvent[]         @relation("PlayerActivityEvents")
  actedEvents          ActivityEvent[]         @relation("ActorActivityEvents")
  kudosGiven           Kudos[]                 @relation("KudosGiven")
  coachChallenges      TeamChallenge[]         @relation("CoachChallenges")
  challengeEntries     ChallengeEntry[]        @relation("PlayerChallengeEntries")
  pushSubscriptions    PushSubscription[]
  teamMessages         TeamMessage[]
  teamChatReads        TeamChatRead[]
  reviewedAssignments  LessonAssignment[]      @relation("AssignmentReviewer")

  @@map("users")
}

model Club {
  id        String     @id @default(cuid())
  shortId   String?    @unique
  name      String     @unique
  city      String?
  country   String?
  createdAt DateTime   @default(now())
  userClubs UserClub[]
  teams     Team[]     @relation("TeamClub")

  @@map("clubs")
}

model UserClub {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, clubId])
  @@map("user_clubs")
}

model Team {
  id          String       @id @default(cuid())
  icon        String?
  shortName   String
  description String?
  category    String
  coachId     String
  clubId      String?
  /// Hours before a training/event when players without an answer get an
  /// automatic reminder; null = off.
  autoRemindHours Int?
  /// Weekly league, team feed with kudos and challenges for the players.
  gameEnabled Boolean @default(true)
  coach       User         @relation("CoachTeams", fields: [coachId], references: [id], onDelete: Cascade)
  club        Club?        @relation("TeamClub", fields: [clubId], references: [id])
  members     TeamMember[]
  practiceSlots PracticeSlot[] @relation("TeamPracticeSlots")
  developmentPlans PlayerDevelopmentPlan[] @relation("TeamDevelopmentPlans")
  lessonAssignments LessonAssignment[]
  journeyTemplateAssignments JourneyTemplateAssignment[]
  events      TeamEvent[]
  attendanceReminders AttendanceReminder[]
  /// Further coaches of the team (the head coach is `coachId`).
  staff       TeamCoach[]
  challenges  TeamChallenge[]
  chatMessages TeamMessage[]
  chatReads   TeamChatRead[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model PlayerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  handicap       Float?
  xp             Int      @default(0)
  level          Int      @default(1)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActivityAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("player_profiles")
}

model CoachPlayerLink {
  id        String   @id @default(cuid())
  coachId   String
  coach     User     @relation("CoachToPlayer", fields: [coachId], references: [id], onDelete: Cascade)
  playerId  String
  player    User     @relation("PlayerToCoach", fields: [playerId], references: [id], onDelete: Cascade)
  /// The coach's role for this player (null = not specified).
  role      CoachRole?
  createdAt DateTime @default(now())

  @@unique([coachId, playerId])
  @@map("coach_player_links")
}

model TaskTemplate {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt

  @@map("task_templates")
}

model GolfChallenge {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt

  @@map("challenges")
}

model PracticeSlot {
  id                String       @id @default(cuid())
  ownerType         OwnerType    @default(PLAYER)
  playerId          String?
  player            User?        @relation("PlayerSlots", fields: [playerId], references: [id], onDelete: Cascade)
  teamId            String?
  team              Team?        @relation("TeamPracticeSlots", fields: [teamId], references: [id], onDelete: Cascade)
  title             String
  startTime         DateTime
  endTime           DateTime
  recurrence        Recurrence   @default(NONE)
  recurrenceEndDate DateTime?
  /// Coach (or player) who created the window; team staff may change their own.
  createdById       String?
  createdBy         User?        @relation("SlotCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks             CalendarTask[]
  attendances       Attendance[]
  exceptions        PracticeSlotException[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("practice_slots")
}

/// One occurrence of a (recurring) team training that was moved or cancelled;
/// the rest of the series stays unchanged.
model PracticeSlotException {
  id             String       @id @default(cuid())
  practiceSlotId String
  practiceSlot   PracticeSlot @relation(fields: [practiceSlotId], references: [id], onDelete: Cascade)
  /// Start of the occurrence in the series (identifies it).
  originalStart  DateTime
  cancelled      Boolean      @default(false)
  /// New time of a moved occurrence (null when cancelled).
  newStart       DateTime?
  newEnd         DateTime?
  /// Shown to the players, e.g. "Course closed".
  reason         String?
  changedById    String?
  changedBy      User?        @relation("SlotExceptionChanger", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([practiceSlotId, originalStart])
  @@map("practice_slot_exceptions")
}

model CalendarTask {
  id              String       @id @default(cuid())
  practiceSlotId  String
  practiceSlot    PracticeSlot @relation(fields: [practiceSlotId], references: [id], onDelete: Cascade)
  coachId         String
  coach           User         @relation("CoachTasks", fields: [coachId], references: [id], onDelete: Cascade)
  title           String
  description     String
  durationMinutes Int
  scheduledDate   DateTime
  status          CalendarTaskStatus @default(PLANNED)
  completedAt     DateTime?
  lessonId        String?
  lesson          TrainingLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  assignmentId    String? @unique
  assignment      LessonAssignment? @relation("AssignmentCalendarTask", fields: [assignmentId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("calendar_tasks")
}

model TrainingLesson {
  id              String           @id @default(cuid())

  // General Information
  name            String
  description     String?
  durationMinutes Int
  focusArea       LessonFocusArea
  subCapability   String?
  subSubCapability String?
  location        String?
  status          LessonStatus     @default(PLANNED)
  visibility      LessonVisibility @default(PRIVATE)
  videoUrl        String?
  /// The lesson this one was copied from (club or public library).
  copiedFromId    String?

  // Ownership
  coachId         String
  coach           User             @relation("CoachLessons", fields: [coachId], references: [id], onDelete: Cascade)
  playerId        String?
  player          User?            @relation("PlayerLessons", fields: [playerId], references: [id], onDelete: SetNull)
  teamId          String?

  // Goal Setting
  trainingObjective  String?
  currentSituation   String?
  targetOutcome      String?
  priority           LessonPriority?
  plannedExercises   String?
  successCriteria    String?
  /// Measurable goal for the mission screen, e.g. 9 (successes) of 10 (attempts).
  targetScore        Int?
  targetAttempts     Int?

  // Results & Performance Tracking
  goalAchieved          GoalAchieved?
  playerSelfAssessment  Int?
  coachRating           Int?
  afterSessionVideoUrl  String?
  performanceScore      Int?
  comments              String?
  keyLearnings          String?

  assignments     LessonAssignment[]
  calendarTasks   CalendarTask[]
  journeyTemplateLessons JourneyTemplateLesson[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([coachId, copiedFromId])
  @@map("training_lessons")
}

// ─── Player Development Plan ───────────────────────────────────────────────

model PlayerDevelopmentPlan {
  id          String         @id @default(cuid())
  name        String
  description String?
  coachId     String
  coach       User           @relation("CoachPlans", fields: [coachId], references: [id], onDelete: Cascade)
  ownerType   OwnerType      @default(PLAYER)
  playerId    String?
  player      User?          @relation("PlayerPlans", fields: [playerId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?          @relation("TeamDevelopmentPlans", fields: [teamId], references: [id], onDelete: Cascade)
  startDate   DateTime?
  endDate     DateTime?
  blocks      TrainingBlock[]
  milestones  DevelopmentPlanMilestone[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("player_development_plans")
}

// ─── Training Block ────────────────────────────────────────────────────────

model TrainingBlock {
  id          String                @id @default(cuid())
  planId      String
  plan        PlayerDevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  coachId     String
  coach       User                  @relation("CoachBlocks", fields: [coachId], references: [id], onDelete: Cascade)
  name        String
  description String?
  goal        String?
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int                   @default(0)
  assignments LessonAssignment[]
  milestones  DevelopmentPlanMilestone[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@map("training_blocks")
}

// ─── Lesson Assignment ─────────────────────────────────────────────────────

model LessonAssignment {
  id             String           @id @default(cuid())
  blockId        String?
  block          TrainingBlock?   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         TrainingLesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  targetType     AssignmentTargetType @default(PLAYER)
  sourceType     AssignmentSourceType @default(PLAYER)
  sourceReference String?
  playerId       String?
  player         User?            @relation("PlayerAssignments", fields: [playerId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  groupName      String?
  coachId        String
  dueDate        DateTime?
  isInTrainingQueue Boolean       @default(false)
  teamEventId    String?
  teamEvent      TeamEvent?       @relation(fields: [teamEventId], references: [id], onDelete: SetNull)
  calendarTask   CalendarTask?    @relation("AssignmentCalendarTask")
  priority       LessonPriority   @default(MEDIUM)
  status         AssignmentStatus @default(NEW)
  completedAt    DateTime?
  /// Set when the coach marked the completed lesson as seen; null = awaiting feedback.
  coachReviewedAt DateTime?
  /// Coach review given back to the player (1–5 stars, comment, "coach's pick").
  coachRating    Int?
  coachComment   String?
  coachPick      Boolean          @default(false)
  reviewedById   String?
  reviewedBy     User?            @relation("AssignmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  /// When the player opened the review; null = new review.
  playerSeenReviewAt DateTime?
  /// Mission result: score against the lesson target, stars (1–3), minutes, ticked exercises.
  resultScore    Int?
  stars          Int?
  practiceMinutes Int?
  exercisesDone  Int[]            @default([])
  sortOrder      Int              @default(0)
  playerNotes    String?
  selfAssessment Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([targetType, playerId])
  @@index([targetType, teamId])
  @@index([isInTrainingQueue])
  @@index([coachId, coachReviewedAt])

  @@map("lesson_assignments")
}

model JourneyTemplate {
  id           String                 @id @default(cuid())
  coachId      String
  coach        User                   @relation("CoachJourneyTemplates", fields: [coachId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  category     String?
  difficulty   JourneyDifficulty?
  visibility   JourneyVisibility      @default(PRIVATE)
  coverImageUrl String?
  /// The journey this one was copied from (club or public library).
  copiedFromId String?
  lessons      JourneyTemplateLesson[]
  assignments  JourneyTemplateAssignment[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([coachId, createdAt])
  @@index([coachId, copiedFromId])
  @@map("journey_templates")
}

model JourneyTemplateLesson {
  id               String          @id @default(cuid())
  journeyTemplateId String
  journeyTemplate  JourneyTemplate @relation(fields: [journeyTemplateId], references: [id], onDelete: Cascade)
  lessonId         String
  lesson           TrainingLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sortOrder        Int             @default(0)
  isRequired       Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([journeyTemplateId, sortOrder])
  @@index([lessonId])
  @@map("journey_template_lessons")
}

model JourneyTemplateAssignment {
  id               String           @id @default(cuid())
  journeyTemplateId String
  journeyTemplate  JourneyTemplate  @relation(fields: [journeyTemplateId], references: [id], onDelete: Cascade)
  playerId         String
  player           User             @relation("JourneyTemplatePlayerAssignments", fields: [playerId], references: [id], onDelete: Cascade)
  teamId           String?
  team             Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  coachId          String
  coach            User             @relation("JourneyTemplateCoachAssignments", fields: [coachId], references: [id], onDelete: Cascade)
  playerPlanId     String
  status           AssignmentStatus @default(NEW)
  completedAt      DateTime?
  isInTrainingQueue Boolean         @default(true)
  source           String           @default("assignedByCoach")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([playerId, isInTrainingQueue, createdAt])
  @@index([coachId, createdAt])
  @@index([teamId])
  @@map("journey_template_assignments")
}

model AvailabilityBlock {
  id                String                @id @default(cuid())
  playerId          String
  player            User                  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  title             String
  type              AvailabilityBlockType @default(CUSTOM)
  startTime         DateTime
  endTime           DateTime
  recurrence        Recurrence            @default(NONE)
  recurrenceEndDate DateTime?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@map("availability_blocks")
}

model TeamEvent {
  id          String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  coachId      String
  coach        User     @relation("CoachTeamEvents", fields: [coachId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  location     String?
  startTime    DateTime
  endTime      DateTime
  assignments  LessonAssignment[]
  attendances  Attendance[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("team_events")
}

model Tournament {
  id          String             @id @default(cuid())
  playerId    String
  player      User               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  priority    TournamentPriority @default(PRIORITY_2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("tournaments")
}

model DevelopmentPlanMilestone {
  id          String                     @id @default(cuid())
  planId       String
  plan         PlayerDevelopmentPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  blockId      String?
  block        TrainingBlock?             @relation(fields: [blockId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  dueDate      DateTime
  status       DevelopmentMilestoneStatus @default(PLANNED)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@map("development_plan_milestones")
}

// Private notes a coach keeps about a player (visible only to that coach).
model CoachPlayerNote {
  id        String   @id @default(cuid())
  coachId   String
  coach     User     @relation("CoachNotes", fields: [coachId], references: [id], onDelete: Cascade)
  playerId  String
  player    User     @relation("NotesAboutPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  body      String
  /// PRIVATE: only the author. SHARED: every coach who works with the player.
  visibility NoteVisibility @default(PRIVATE)
  /// Coaches mentioned with @Name (they get a push and see it on their home).
  mentionIds String[] @default([])
  /// Handover note for a stand-in coach: shared and pinned on top.
  isHandover Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId, playerId, createdAt])
  @@index([playerId, visibility, createdAt])
  @@map("coach_player_notes")
}

enum NoteVisibility {
  PRIVATE
  SHARED
}

/// Secret token behind a user's calendar subscription URL (ICS feed).
model CalendarFeedToken {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String    @unique
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("calendar_feed_tokens")
}

enum AttendanceStatus {
  GOING
  MAYBE
  NOT_GOING
}

/// A player's answer for one occurrence of a team training window or team event.
model Attendance {
  id              String           @id @default(cuid())
  playerId        String
  player          User             @relation("PlayerAttendances", fields: [playerId], references: [id], onDelete: Cascade)
  practiceSlotId  String?
  practiceSlot    PracticeSlot?    @relation(fields: [practiceSlotId], references: [id], onDelete: Cascade)
  teamEventId     String?
  teamEvent       TeamEvent?       @relation(fields: [teamEventId], references: [id], onDelete: Cascade)
  /// "slot:<slotId>:<occurrence start ISO>" or "event:<eventId>"
  occurrenceKey   String
  occurrenceStart DateTime
  status          AttendanceStatus
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([playerId, occurrenceKey])
  @@index([occurrenceKey])
  @@index([practiceSlotId, occurrenceStart])
  @@map("attendances")
}

enum ReminderKind {
  MANUAL
  AUTO
}

/// Reminder sent to the players who have not answered for a team session.
model AttendanceReminder {
  id             String       @id @default(cuid())
  /// Same key as Attendance.occurrenceKey.
  occurrenceKey  String
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Coach who pressed "Remind"; null for automatic reminders.
  sentById       String?
  sentBy         User?        @relation("ReminderSender", fields: [sentById], references: [id], onDelete: SetNull)
  kind           ReminderKind
  recipientCount Int
  sentAt         DateTime     @default(now())

  @@index([occurrenceKey, sentAt])
  @@index([teamId, sentAt])
  @@map("attendance_reminders")
}

enum CoachRole {
  HEAD_COACH
  ASSISTANT
  FITNESS
  MENTAL
}

/// A further coach of a team (assistant, fitness, mental …).
model TeamCoach {
  id        String    @id @default(cuid())
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User      @relation("TeamStaff", fields: [coachId], references: [id], onDelete: Cascade)
  role      CoachRole @default(ASSISTANT)
  createdAt DateTime  @default(now())

  @@unique([teamId, coachId])
  @@index([coachId])
  @@map("team_coaches")
}

/// One chat between a coach and a player.
model Conversation {
  id            String    @id @default(cuid())
  coachId       String
  coach         User      @relation("ConversationCoach", fields: [coachId], references: [id], onDelete: Cascade)
  playerId      String
  player        User      @relation("ConversationPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  /// Everything up to this time counts as read by the coach / the player.
  coachReadAt   DateTime?
  playerReadAt  DateTime?
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([coachId, playerId])
  @@index([playerId, lastMessageAt])
  @@index([coachId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  /// Coach asks for an answer: shown on the player home until answered.
  isQuestion     Boolean      @default(false)
  /// Linked item, e.g. refType "assignment" with the mission id.
  refType        String?
  refId          String?
  refTitle       String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Everything a player did that counts for the game (XP ledger) and shows in
/// the coach activity feed and the team feed.
model ActivityEvent {
  id        String   @id @default(cuid())
  playerId  String
  player    User     @relation("PlayerActivityEvents", fields: [playerId], references: [id], onDelete: Cascade)
  /// Who caused it when it was not the player (coach review, kudos …).
  actorId   String?
  actor     User?    @relation("ActorActivityEvents", fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  /// Makes the event unique per player and type (assignment id, week key …).
  refKey    String
  refId     String?
  title     String?
  xp        Int      @default(0)
  meta      Json?
  createdAt DateTime @default(now())
  kudos     Kudos[]

  @@unique([playerId, type, refKey])
  @@index([playerId, createdAt])
  @@index([createdAt])
  @@map("activity_events")
}

/// A teammate's "well done" on an activity event.
model Kudos {
  id        String        @id @default(cuid())
  eventId   String
  event     ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromId    String
  from      User          @relation("KudosGiven", fields: [fromId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([eventId, fromId])
  @@map("kudos")
}

/// Coach challenge for a team with a leaderboard; benchmark tests feed the player card.
model TeamChallenge {
  id             String           @id @default(cuid())
  teamId         String
  team           Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  coachId        String
  coach          User             @relation("CoachChallenges", fields: [coachId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  focusArea      LessonFocusArea?
  unit           String           @default("points")
  higherIsBetter Boolean          @default(true)
  /// Score that counts as 100 % for a benchmark test.
  targetScore    Int?
  isBenchmark    Boolean          @default(false)
  startsAt       DateTime
  endsAt         DateTime
  entries        ChallengeEntry[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([teamId, endsAt])
  @@map("team_challenges")
}

model ChallengeEntry {
  id          String        @id @default(cuid())
  challengeId String
  challenge   TeamChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  playerId    String
  player      User          @relation("PlayerChallengeEntries", fields: [playerId], references: [id], onDelete: Cascade)
  score       Int
  note        String?
  createdAt   DateTime      @default(now())

  @@index([challengeId, playerId])
  @@map("challenge_entries")
}

/// Web push subscription of one browser/device.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("push_subscriptions")
}

/// Team chat: players and coaches of a team.
model TeamMessage {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  refType   String?
  refId     String?
  refTitle  String?
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
  @@map("team_messages")
}

/// Up to when a user has read a team chat.
model TeamChatRead {
  id     String   @id @default(cuid())
  teamId String
  team   Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime

  @@unique([teamId, userId])
  @@map("team_chat_reads")
}
