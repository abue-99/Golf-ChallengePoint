# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/challengepoint"

# JWT Secrets (replace with strong random secrets in production)
ACCESS_SECRET="your-access-token-secret-change-me"
REFRESH_SECRET="your-refresh-token-secret-change-me"

# Token Expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# App
PORT=4000
NODE_ENV="development"

# --- Production only (server .env) ---
# Public API URL used by the Next.js web app
NEXT_PUBLIC_API_URL="http://YOUR_SERVER_IP_OR_HOSTNAME:4000"

# Pre-built Docker images pulled from GitHub Container Registry
GHCR_WEB_IMAGE="ghcr.io/abue-99/golf-challengepoint-web:latest"
GHCR_API_IMAGE="ghcr.io/abue-99/golf-challengepoint-api:latest"
