# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/challengepoint"

# JWT Secrets (replace with strong random secrets in production)
ACCESS_SECRET="your-access-token-secret-change-me"
REFRESH_SECRET="your-refresh-token-secret-change-me"

# Token Expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# App
PORT=4000
NODE_ENV="development"

# Web → API (internal Docker hostname; used by Next.js Route Handlers server-side)
API_URL="http://golf_api:4000"

# CORS: URL of the frontend as seen by the browser
FRONTEND_URL="http://localhost:3000"

# Next.js public API URL (baked in at build time; visible to the browser)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Domain / IP used by Caddy as hostname (no HTTPS without a real domain)
DOMAIN="localhost"
