# Database – Managed Postgres (e.g. Neon, Supabase, Railway)
# Obtain your connection string from the managed DB dashboard and paste it here.
# For Neon: postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
# This single variable is used by both the API and the Web containers.
DATABASE_URL="postgresql://user:password@host.neon.tech/challengepoint?sslmode=require"

# JWT Secrets (replace with strong random secrets in production)
ACCESS_SECRET="your-access-token-secret-change-me"
REFRESH_SECRET="your-refresh-token-secret-change-me"

# Token Expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# App
PORT=4000
NODE_ENV="development"

# Web → API (internal Docker hostname; used by Next.js Route Handlers server-side)
API_URL="http://golf_api:4000"

# CORS: URL of the frontend as seen by the browser
FRONTEND_URL="http://localhost:3000"

# Next.js public API URL (visible to the browser; routes through Caddy /api/* in production)
# DEV:  NEXT_PUBLIC_API_URL="http://localhost:4000"
# PROD: NEXT_PUBLIC_API_URL="http://178.104.48.239/api"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Public app URL (used for absolute links / redirects)
# DEV:  NEXT_PUBLIC_APP_URL="http://localhost:3000"
# PROD: NEXT_PUBLIC_APP_URL="http://178.104.48.239"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cookie Security
# Set to "true" when serving the app over HTTPS; leave "false" for plain HTTP
# DEV:  SECURE_COOKIES=false
# PROD: SECURE_COOKIES=false  (change to "true" once HTTPS/TLS is enabled)
SECURE_COOKIES=false

# Domain / IP used by Caddy as the HTTP hostname
# DEV:  DOMAIN="localhost"
# PROD: DOMAIN="178.104.48.239"
DOMAIN="localhost"

# Resend API key – used for invitation emails and password-reset emails.
# OPTIONAL: if left empty the app still works; emails are simply skipped (a warning is logged).
# Obtain from https://resend.com/api-keys
# The sender domain (contact.golf-challengepoint.com) must be verified in the Resend dashboard.
# RESEND_API_KEY="re_your_api_key_here"

# Sender address shown on outgoing emails (override if needed).
# RESEND_FROM_EMAIL="noreply@contact.golf-challengepoint.com"