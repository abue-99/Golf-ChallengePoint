# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/challengepoint"

# JWT Secrets (replace with strong random secrets in production)
ACCESS_SECRET="your-access-token-secret-change-me"
REFRESH_SECRET="your-refresh-token-secret-change-me"

# Token Expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# App
PORT=4000
NODE_ENV="development"

# Public URL of the API server (used by the browser — must be reachable from the internet)
# For local development: http://localhost:4000
# For production: http://<your-server-ip>:4000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Public URL of the frontend (used by the API for CORS)
# For local development: http://localhost:3000
# For production: http://<your-server-ip>:3000
FRONTEND_URL="http://localhost:3000"
