# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/challengepoint"

# JWT Secrets (replace with strong random secrets in production)
ACCESS_SECRET="your-access-token-secret-change-me"
REFRESH_SECRET="your-refresh-token-secret-change-me"

# Token Expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# App
PORT=4000
NODE_ENV="development"

# Web → API (internal Docker hostname; used by Next.js Route Handlers server-side)
API_URL="http://golf_api:4000"

# CORS: URL of the frontend as seen by the browser
FRONTEND_URL="http://localhost:3000"

# Next.js public API URL (baked in at build time; visible to the browser)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---------------------------------------------------------
# CI/CD – required GitHub Actions secrets for production
# (set these in: Settings → Secrets and variables → Actions)
# ---------------------------------------------------------
# DEPLOY_HOST          = IP or hostname of the production server
# DEPLOY_USER          = SSH username on the production server
# DEPLOY_SSH_KEY       = private SSH key (public key must be in ~/.ssh/authorized_keys on the server)
# NEXT_PUBLIC_API_URL  = public URL of the API as seen by the browser, e.g. https://api.example.com
# GHCR_TOKEN           = GitHub Personal Access Token with `read:packages` scope (used by the server to pull images from GHCR)
